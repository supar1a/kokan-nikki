// 短冊 — data model
//
// アカウントはない。ブラウザに残るクッキーが、そのまま「その人」を指す。
// 名前は最初に一度きいて、それだけ。照合するものが何もないので、
// なりすましは原理的に防げない。そこは仲間うちであることに委ねている。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

/// 名乗り。名前のほかに持つものがない。
model User {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  sessions    Session[]
  memberships Membership[]
  slips       Slip[]
}

/// ブラウザに置いたクッキーの控え。
model Session {
  token     String   @id
  userId    String
  expires   DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// 仲間うちの閉じたグループ。この URL を渡された人が入れる。
model Place {
  id          String   @id @default(cuid())
  /// 招待 URL の実体。これを知っていることが、そのまま入場券になる。
  slug        String   @unique
  name        String
  description String?
  /// 口頭でも渡せるようにした、もうひとつの入口。
  passphrase  String   @unique
  createdAt   DateTime @default(now())

  memberships Membership[]
  slips       Slip[]
}

model Membership {
  id         String    @id @default(cuid())
  userId     String
  placeId    String
  role       String    @default("member") // "owner" | "member"
  /// 前にこのグループを見た時刻。「ここから未読」の目印にだけ使う。数は出さない。
  lastReadAt DateTime?
  joinedAt   DateTime  @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([userId, placeId])
  @@index([placeId])
}

model Slip {
  id        String   @id @default(cuid())
  placeId   String
  authorId  String
  body      String
  /// 公開しているか。下書きは書いた本人にだけ見える。
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  place  Place @relation(fields: [placeId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([placeId, createdAt])
  @@index([authorId])
}
