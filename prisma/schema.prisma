// 短冊 — data model
//
// 仲間うちだけのグループに、それぞれが短冊を投稿していく。
// 手番も宛先も返事もない。
// いいね・既読・閲覧数のたぐいは、表にも裏にも持たない。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// --- 名乗り ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  /// 名前だけで始めた人の「戻り口」。
  passKey       String?   @unique
  createdAt     DateTime  @default(now())

  accounts    Account[]
  sessions    Session[]
  memberships Membership[]
  slips       Slip[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// --- 場と、短冊 ---

/// 仲間うちの閉じたグループ。合言葉を知っている人だけが入れる。
model Place {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  /// 合言葉。これを知っている人だけが入れる。作った人が決める。
  passphrase  String   @unique
  createdAt   DateTime @default(now())

  memberships Membership[]
  slips       Slip[]
}

model Membership {
  id       String   @id @default(cuid())
  userId   String
  placeId  String
  role     String   @default("member") // "owner" | "member"
  /// 前にこのグループを見た時刻。ここより後の短冊に「未読」の目印をつけるためだけに使う。
  /// 未読の「数」はどこにも出さない。数が出た時点で、読む義務になってしまうので。
  lastReadAt DateTime?
  joinedAt   DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([userId, placeId])
  @@index([placeId])
}

/// 一枚の短冊。
model Slip {
  id        String   @id @default(cuid())
  placeId   String
  authorId  String
  body      String
  /// 公開しているか。下書きは書いた本人にだけ見える。
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  place  Place @relation(fields: [placeId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([placeId, createdAt])
  @@index([authorId])
}
